# ------------------------------------------------------------------
# DealFlowIQ environment variables
# Copy this file to .env.local and fill in real values.
# See docs/env-vars.md for a full description of each variable.
# ------------------------------------------------------------------

# --- Supabase (required) ------------------------------------------
# Project URL and anon key: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only, NEVER expose to the browser).
# Used for Stripe webhook sync, storage uploads and the import worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URLs ------------------------------------------------------
# Canonical public URL of the app (used in Stripe/auth redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional alternative used by password reset emails; falls back to
# NEXT_PUBLIC_APP_URL, then VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# VERCEL_URL is injected automatically on Vercel; do not set manually.

# --- Stripe (required for paid plans) ------------------------------
# Secret key: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cron ----------------------------------------------------------
# Shared secret protecting /api/cron/* routes. Required in production.
# Configure the same value as the header sent by your scheduler
# (Vercel Cron sends it automatically when set as a project env var).
CRON_SECRET=generate-a-long-random-string

# --- Resend (optional, community invite emails) --------------------
# RESEND_API_KEY=re_...
# COMMUNITY_INVITE_FROM_EMAIL="DealFlowIQ <noreply@yourdomain.com>"
# RESEND_FROM_EMAIL="DealFlowIQ <noreply@yourdomain.com>"

# --- HUD FMR integration (optional, Section 8 rent lookups) --------
# Token from https://www.huduser.gov/portal/dataset/fmr-api.html
# HUDUSER_API_TOKEN=your-hud-user-token
# Legacy alias, checked if HUDUSER_API_TOKEN is unset:
# HUD_USER_API_TOKEN=
# Year selection: "auto" (default) or a specific year, e.g. 2026
# HUDUSER_DEFAULT_YEAR=auto
# Force a specific FMR year regardless of auto detection:
# HUDUSER_FORCE_YEAR=
# Override the HUD API base URLs (rarely needed):
# HUDUSER_FMR_API_BASE_URL=
# HUDUSER_USPS_API_BASE_URL=
# Custom lookup URL template (advanced):
# HUDUSER_FMR_LOOKUP_URL_TEMPLATE=
# Allow direct ZIP fallback when USPS crosswalk resolution fails:
# HUDUSER_ALLOW_DIRECT_ZIP_FALLBACK=false

# --- Zillow rent comp import (optional) -----------------------------
# Custom user agent for outbound requests:
# ZILLOW_USER_AGENT=

# --- Observability (optional) ---------------------------------------
# Forward server error events (JSON POST) to Slack/Sentry-proxy/etc.
# ERROR_WEBHOOK_URL=
